{
  "_comment": "Multi-account / per-category JSON shape for reference. Do NOT copy over .mcp.json — that file is committed and must never contain a real token. Nor should a real token go here: every value below is a ${VAR} env PLACEHOLDER, which Claude Code expands from its own environment when it launches the server (this works for local- and user-scoped entries in ~/.claude.json too, not only a project .mcp.json). Give each Hostinger ACCOUNT its own variable name — HOSTINGER_TOKEN_ACCTA, HOSTINGER_TOKEN_ACCTB — and export them where Claude Code starts; the variable the server receives is always HOSTINGER_API_TOKEN, only the source differs, which is what keeps the accounts separated. A literal here would sit in plaintext in whatever file you paste it into, and `claude mcp add -e HOSTINGER_API_TOKEN=<value>` would additionally put it in your shell history and in ps; see references/installation.md, \"Handling the token safely\". One connection per category binary you need (keeps context lean) and one per account. Get the API token from hPanel. Upstream states Node.js v24+ (verified working on Node 22).",
  "mcpServers": {
    "hostinger-acctA-vps": {
      "type": "stdio",
      "command": "hostinger-vps-mcp",
      "env": { "HOSTINGER_API_TOKEN": "${HOSTINGER_TOKEN_ACCTA:-}" }
    },
    "hostinger-acctA-dns": {
      "type": "stdio",
      "command": "hostinger-dns-mcp",
      "env": { "HOSTINGER_API_TOKEN": "${HOSTINGER_TOKEN_ACCTA:-}" }
    },
    "hostinger-acctB-vps": {
      "type": "stdio",
      "command": "hostinger-vps-mcp",
      "env": { "HOSTINGER_API_TOKEN": "${HOSTINGER_TOKEN_ACCTB:-}" }
    }
  }
}
